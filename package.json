{
  "name": "kias",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0",
    "dev:ngrok": "next dev --turbopack --hostname 0.0.0.0",
    "build": "next build --turbopack",
    "postinstall": "",
    "start": "next start",
    "start:fresh": "pnpm build && pnpm start",
    "restart:fresh": "powershell -ExecutionPolicy Bypass -File scripts/restart-fresh.ps1",
    "lint": "eslint",
    "ngrok": "npx ngrok http 3000",
    "onlyoffice:up": "powershell -ExecutionPolicy Bypass -File scripts/onlyoffice-local.ps1",
    "onlyoffice:down": "docker compose -f docker-compose.onlyoffice.local.yml down",
    "onlyoffice:logs": "docker compose -f docker-compose.onlyoffice.local.yml logs -f onlyoffice"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "docxtemplater": "^3.65.0",
    "dotenv": "^17.2.3",
    "file-saver": "^2.0.5",
    "formidable": "^3.5.4",
    "gsap": "^3.13.0",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "next": "16.2.6",
    "next-auth": "^4.24.13",
    "node-html-parser": "^7.1.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.394",
    "pdfjs-serverless": "^1.1.0",
    "pg": "^8.16.3",
    "pizzip": "^3.1.8",
    "prettier": "^3.6.2",
    "prisma": "^6.15.0",
    "react": "19.2.4",
    "react-calendar": "^6.0.0",
    "react-dom": "19.2.4",
    "react-icons": "^5.5.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4"
  }
}
